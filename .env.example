# Lead-capture email (see how much you'd save modal) — Resend
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
# Verified sender. Verify the domain you control (the site domain, joinspine.ai)
# in Resend; it need NOT match the recipients. Until verified, use the sandbox:
#   ESTIMATE_FROM="Spine <onboarding@resend.dev>"
ESTIMATE_FROM="Spine <noreply@joinspine.ai>"
# Where form submissions are emailed (comma-separated).
ESTIMATE_TO=Tech@tryheal.ai,onur@tryheal.ai

# ── Calendly (booking step of the same form) ───────────────────────
# The scheduling link the sheet turns into after the details are submitted.
# Copy it from Calendly → the event type → "Copy link". Public by design (it
# runs in the browser). Leave empty and the flow degrades to "we'll email you".
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/<user>/<event>

# ── Slack handoff (funnel CTAs → bot first message) ────────────────
# See docs/slack-handoff.md. The install link the Add-to-Slack CTAs use;
# leave empty and the specialist link takes the primary slot.
NEXT_PUBLIC_SLACK_INSTALL_URL=
# Server-only HMAC key for the handoff state token (share with the bot).
# Generate: openssl rand -hex 32. Empty → tokens aren't minted, CTAs still work.
SLACK_HANDOFF_SECRET=

# ── Sanity (blog CMS) ──────────────────────────────────────────────
# Public (browser-safe) project coordinates.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-05-15
# Server-only secrets — get from `npx sanity manage` → API → Tokens.
SANITY_API_READ_TOKEN=
# Shared secret set on the Sanity webhook that triggers /api/revalidate.
SANITY_REVALIDATE_SECRET=
